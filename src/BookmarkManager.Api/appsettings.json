{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=/data/bookmarks.db"
  },
  "Library": {
    "Enabled": true,
    "EnableRoyalRoad": true,
    "SearchTimeoutSeconds": 5,
    "ModelIdleUnloadMinutes": 15,
    "BackgroundScheduleTime": "04:00",
    "TimeZoneId": "Europe/Berlin"
  },
  "UrlMigration": {
    "SearxngBaseUrl": "http://searxng:8080",
    "DiscoverySampleSize": 20
  },
  "Suwayomi": {
    "BaseUrl": "http://suwayomi:4567",
    "PublicBaseUrl": "http://phamezan.capybara-pirarucu.ts.net:4567",
    "SourceOrder": [
      "Asura Scans",
      "Vortex Scans",
      "MangaDex",
      "Manganato",
      "MangaRead.org",
      "Weeb Central"
    ]
  },
  "Backup": {
    "Directory": "/data/backups/db",
    "Enabled": true,
    "ScheduleTime": "03:00",
    "TimeZoneId": "Europe/Berlin",
    "RetentionMaxCount": 30,
    "RetentionMaxAgeDays": 60,
    "MinFreeDiskBytes": 268435456,
    "StopHostAfterRestore": true
  }
}
