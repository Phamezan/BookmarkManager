@namespace BookmarkManager.Client.Components
@using BookmarkManager.Contracts
@inject IBookmarkService BookmarkService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(string.IsNullOrWhiteSpace(Title) ? "Enter URL manually" : Title)</MudText>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">
            @BookmarkTitle
        </MudText>
        <MudAutocomplete T="string"
                          @bind-Value="_url"
                          SearchFunc="SearchUrlsAsync"
                          Label="URL"
                          Placeholder="https://"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          MinCharacters="2"
                          DebounceInterval="250"
                          ShowProgressIndicator="true"
                          CoerceValue="true"
                          CoerceText="true"
                          Class="manual-url-field" />
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Submit"
                   Disabled="@(!IsValidUrl(_url))"
                   Class="manual-url-submit">
            Save URL
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string BookmarkTitle { get; set; } = string.Empty;
    [Parameter] public string? InitialUrl { get; set; }
    [Parameter] public string? Title { get; set; }

    private string _url = string.Empty;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(InitialUrl))
        {
            _url = InitialUrl;
        }
    }

    private static bool IsValidUrl(string? url)
        => !string.IsNullOrWhiteSpace(url)
           && Uri.TryCreate(url, UriKind.Absolute, out var uri)
           && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);

    private async Task<IEnumerable<string>> SearchUrlsAsync(string? value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value)) return [];

        var result = await BookmarkService.SearchBookmarksAsync(
            new SearchRequest { Query = value, PageSize = 20 },
            cancellationToken);

        return result.Items
            .Where(b => !string.IsNullOrWhiteSpace(b.Url))
            .Select(b => b.Url!)
            .Distinct()
            .Take(8);
    }

    private void Submit()
    {
        if (!IsValidUrl(_url)) return;
        MudDialog.Close(DialogResult.Ok(_url));
    }

    private void Cancel() => MudDialog.Cancel();
}
